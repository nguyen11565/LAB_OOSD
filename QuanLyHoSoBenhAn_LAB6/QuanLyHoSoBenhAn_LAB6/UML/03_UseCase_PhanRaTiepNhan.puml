@startuml
left to right direction
title PHÂN RÃ USE CASE - TIẾP NHẬN → XÉT NGHIỆM → TOA
actor "Bệnh nhân" as BN
actor "Nhân viên CSKH" as NV
actor "Bác sĩ" as BS
actor "Nhân viên xét nghiệm" as XN
rectangle "Quy trình khám bệnh" {
 usecase "Tiếp nhận đăng ký khám" as R
 usecase "Tra cứu mã hồ sơ" as Lookup
 usecase "Đăng ký lần đầu / Thu phí / Cấp hồ sơ" as New
 usecase "Mở phiếu khám" as Exam
 usecase "Khám & ghi triệu chứng" as Symptoms
 usecase "Chẩn đoán" as Diagnosis
 usecase "Chỉ định xét nghiệm" as OrderLab
 usecase "Ghi kết quả xét nghiệm" as Result
 usecase "Lập toa thuốc" as Rx
 usecase "Thêm chi tiết thuốc" as Item
}
BN -- R
NV -- R
NV -- New
BS -- Exam
BS -- Symptoms
BS -- Diagnosis
BS -- OrderLab
BS -- Rx
XN -- Result
R ..> Lookup : <<include>>
New ..> R : <<extend>>
Exam ..> Lookup : <<include>>
Exam ..> Symptoms : <<include>>
Exam ..> Diagnosis : <<include>>
OrderLab ..> Exam : <<extend>>
Result ..> OrderLab : <<extend>>
Rx ..> Exam : <<extend>>
Rx ..> Item : <<include>>
@enduml
